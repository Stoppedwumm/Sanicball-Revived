<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SanicballCore</RootNamespace>
    <AssemblyName>SanicballCore</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Lidgren.Network">
      <HintPath>..\..\Assets\Assemblies\Lidgren\Lidgren.Network.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\Assets\Assemblies\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <!-- Keep Unity and Mono references as assembly references so Unity types are available at compile time. -->
    <Reference Include="Mono.Security">
      <HintPath>..\unitybinaries\Mono.Security.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="UnityEngine, Version=0.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <HintPath>..\unitybinaries\UnityEngine.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule, Version=0.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <HintPath>..\unitybinaries\UnityEngine.CoreModule.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Let the SDK include all .cs files implicitly. Explicit Compile entries removed. -->

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)..\..\Assets\Assemblies" SkipUnchangedFiles="true" />
  </Target>

</Project>
